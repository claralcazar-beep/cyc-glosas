# Variables de entorno en Vercel → Settings → Environment Variables
# La URL y la clave pública de Supabase ya están en lib/supabase/config.ts; aquí solo si quieres sobreescribirlas.
# NEXT_PUBLIC_SUPABASE_URL=https://hszfnckftusoydzcdfhy.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# OBLIGATORIA: clave de la API de Anthropic (solo servidor; nunca con prefijo NEXT_PUBLIC_ ni dentro del código)
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: sobreescribe los modelos definidos en la tabla parametros
# MODELO_EXTRACCION=claude-sonnet-5-5
# MODELO_ANALISIS=claude-opus-5-5
